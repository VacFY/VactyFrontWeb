# ── Desarrollo ────────────────────────────────────────────────
# A dónde reenvía Vite las rutas /api y /ws (el front corre en http://localhost:8000).
BACKEND_URL=https://vacfybackend.onrender.com

# ── Producción ────────────────────────────────────────────────
# REST: déjalo vacío si el hosting reenvía /api al backend (ver vercel.json); así la cookie es del mismo sitio.
VITE_API_URL=
# WebSockets: el hosting no puede reenviarlos, así que van directo al backend.
# El dominio del front debe estar en ALLOWED_ORIGINS del backend.
VITE_WS_URL=wss://vacfybackend.onrender.com
